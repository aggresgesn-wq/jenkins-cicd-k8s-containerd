pipeline {
    agent {
        kubernetes {
            // 构建节点不再使用 privileged 容器，也不挂载宿主机 containerd socket；
            // 镜像构建交给 kaniko（用户态执行，无需 docker daemon）。
            yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-deployer
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    fsGroup: 1000
  containers:
  # 后端：单元测试 + 安全扫描
  - name: python
    image: swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/python:3.11
    command: ['cat']
    tty: true
    resources:
      limits: {cpu: "1", memory: "1Gi"}
      requests: {cpu: "200m", memory: "256Mi"}
  # 前端：npm ci + lint + 生产构建
  - name: node
    image: swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/node:18
    command: ['cat']
    tty: true
    resources:
      limits: {cpu: "1", memory: "2Gi"}
      requests: {cpu: "200m", memory: "512Mi"}
  # 镜像构建与推送
  - name: kaniko
    image: swr.cn-north-4.myhuaweicloud.com/ddn-k8s/gcr.io/kaniko-project/executor:v1.23.2-debug
    command: ['/busybox/cat']
    tty: true
    resources:
      limits: {cpu: "1", memory: "2Gi"}
      requests: {cpu: "200m", memory: "512Mi"}
  # 部署与健康检查
  - name: kubectl
    image: swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/bitnami/kubectl:1.29
    command: ['cat']
    tty: true
    resources:
      limits: {cpu: "500m", memory: "512Mi"}
      requests: {cpu: "100m", memory: "128Mi"}
"""
        }
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['staging', 'production'], description: '部署目标环境')
        booleanParam(name: 'RUN_SECURITY_SCAN', defaultValue: true, description: '是否执行安全扫描')
        string(name: 'IMAGE_TAG_OVERRIDE', defaultValue: '', description: '可选：覆盖镜像 tag（默认取 git short sha）')
    }

    triggers {
        // 每天凌晨 2 点定时构建，便于发现上游依赖漂移；push 触发仍由 GitHub Webhook 负责
        cron('H 2 * * *')
    }

    environment {
        REGISTRY      = "crpi-m67ogm8wgcr0rh38.cn-hangzhou.personal.cr.aliyuncs.com"
        REG_NAMESPACE = "${env.ACR_NAMESPACE ?: 'your-namespace'}"
        IMG_NAME      = "webapp"
        TAG           = "${params.IMAGE_TAG_OVERRIDE ?: (env.GIT_COMMIT ? env.GIT_COMMIT.take(8) : 'latest')}"
        FULL_IMG      = "${REGISTRY}/${REG_NAMESPACE}/${IMG_NAME}:${TAG}"
        K8S_NS        = "webapp"
        K8S_DEPLOY    = "webapp"
        STAGING_HOST  = "webapp-staging.example.com"
        PROD_HOST     = "webapp.example.com"
        PIP_INDEX     = "https://pypi.tuna.tsinghua.edu.cn/simple"
        NPM_REGISTRY  = "https://registry.npmmirror.com"
        GITHUB_REPO   = "aggresgesn-wq/jenkins-gitea-k8s-containerd"
    }

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['staging', 'production'], description: '部署目标环境')
        booleanParam(name: 'RUN_SECURITY_SCAN', defaultValue: true, description: '是否执行安全扫描')
        string(name: 'IMAGE_TAG_OVERRIDE', defaultValue: '', description: '可选：覆盖镜像 tag（默认取 git short sha）')
    }

    triggers {
        // 每天凌晨 2 点定时构建，便于发现上游依赖漂移；push 触发仍由 GitHub Webhook 负责
        cron('H 2 * * *')
    }

    stages {
        stage('1. 检出代码（GitHub）') {
            steps {
                checkout scm
                sh 'git log -1 --pretty=format:"%h %s"'
                githubStatus('pending', 'pipeline started')
            }
        }

        stage('2. 后端测试') {
            steps {
                container('python') {
                    sh '''
                        set -e
                        cd webapp
                        mkdir -p reports
                        python -m pip install -q --disable-pip-version-check -i "$PIP_INDEX" -e ".[dev]"
                        python -m pytest -q --maxfail=1 --junitxml=reports/junit.xml
                    '''
                }
                junit allowEmptyResults: true, testResults: 'webapp/reports/junit.xml'
                archiveArtifacts artifacts: 'webapp/reports/junit.xml', allowEmptyArchive: true
            }
        }

        stage('3. 前端构建') {
            steps {
                container('node') {
                    sh '''
                        set -e
                        cd webapp/ui
                        npm ci --registry="$NPM_REGISTRY" --no-audit --no-fund
                        npm run lint -- --no-fix || echo "lint 存在告警，不阻塞构建"
                        npm run build:prod
                    '''
                    archiveArtifacts artifacts: 'webapp/ui/dist/**', allowEmptyArchive: true
                }
            }
        }

        stage('4. 安全扫描') {
            steps {
                container('python') {
                    sh '''
                        set -e
                        cd webapp
                        python -m pip install -q --disable-pip-version-check -i "$PIP_INDEX" bandit pip-audit
                        echo "--- 静态安全扫描 (bandit) ---"
                        bandit -q -r app -ll -x tests || true
                        echo "--- 依赖漏洞扫描 (pip-audit) ---"
                        pip-audit -r <(python - <<'PY'
import tomllib, pathlib
deps = tomllib.loads(pathlib.Path("pyproject.toml").read_text())["project"]["dependencies"]
print("\n".join(deps))
PY
                        ) || true
                        echo "--- 硬编码密钥检查 ---"
                        if grep -rInE "(password|passwd|secret|token)[[:space:]]*=[[:space:]]*['\\\"][^'\\\"]{6,}" app config.py | grep -v "os.environ"; then
                          echo "发现可疑硬编码凭据，构建失败"; exit 1
                        fi
                    '''
                }
            }
        }

        stage('5. 构建并推送镜像') {
            steps {
                container('kaniko') {
                    withCredentials([usernamePassword(credentialsId: 'acr-credentials',
                                                      usernameVariable: 'REG_USER',
                                                      passwordVariable: 'REG_PASS')]) {
                        sh '''
                            set -e
                            mkdir -p /kaniko/.docker
                            AUTH=$(printf "%s:%s" "$REG_USER" "$REG_PASS" | base64 | tr -d '\\n')
                            cat > /kaniko/.docker/config.json <<EOF
{"auths":{"$REGISTRY":{"auth":"$AUTH"}}}
EOF
                            /kaniko/executor \
                              --context=webapp \
                              --dockerfile=dockerfile \
                              --destination="$FULL_IMG" \
                              --digest-file=/workspace/.image-digest \
                              --snapshot-mode=redo \
                              --compressed-caching=false \
                              --reproducible
                            test -s /workspace/.image-digest && echo "镜像 digest: $(cat /workspace/.image-digest)"
                        '''
                    }
                }
            }
        }

        stage('6. 部署测试环境') {
            steps {
                container('kubectl') {
                    sh '''
                        set -e
                        kubectl -n "$K8S_NS" set image deployment/$K8S_DEPLOY \
                          "$K8S_DEPLOY=$FULL_IMG" --record=false
                        kubectl -n "$K8S_NS" rollout status deployment/$K8S_DEPLOY --timeout=180s
                    '''
                }
            }
        }

        stage('7. 健康检查') {
            steps {
                container('kubectl') {
                    sh '''
                        set -e
                        IP=$(kubectl -n "$K8S_NS" get svc "$K8S_DEPLOY" -o jsonpath='{.spec.clusterIP}')
                        for path in /health/live /health/ready; do
                          for i in $(seq 1 20); do
                            if curl -fsS "http://$IP$path" >/dev/null; then echo "$path OK"; break; fi
                            [ "$i" = "20" ] && { echo "$path 检查失败"; exit 1; }
                            sleep 3
                          done
                        done
                    '''
                }
            }
        }

        stage('8. 人工批准') {
            steps {
                input message: "确认发布到生产环境 ${FULL_IMG} ?", ok: "发布"
            }
        }

        stage('9. 生产部署') {
            steps {
                container('kubectl') {
                    sh '''
                        set -e
                        kubectl -n "$K8S_NS" annotate deployment/$K8S_DEPLOY \
                          "ci/previous-image=$(kubectl -n "$K8S_NS" get deployment/$K8S_DEPLOY -o jsonpath='{.spec.template.spec.containers[0].image}')" \
                          --overwrite
                        kubectl -n "$K8S_NS" set image deployment/$K8S_DEPLOY "$K8S_DEPLOY=$FULL_IMG"
                        kubectl -n "$K8S_NS" rollout status deployment/$K8S_DEPLOY --timeout=300s
                    '''
                }
            }
        }
    }

    post {
        success {
            githubStatus('success', 'pipeline succeeded')
            notifyBuild('SUCCESS')
            echo "✅ 流水线完成，镜像 ${FULL_IMG} 已发布"
        }
        failure {
            container('kubectl') {
                sh '''
                    # 生产发布失败时自动回滚到上一个版本；测试环境失败则保留现场便于排查
                    if [ -n "$(kubectl -n "$K8S_NS" get deployment/$K8S_DEPLOY -o jsonpath='{.spec.template.spec.containers[0].image}' | grep "$TAG")" ] \
                       && [ -n "$(kubectl -n "$K8S_NS" rollout history deployment/$K8S_DEPLOY 2>/dev/null | tail -n +2)" ]; then
                      kubectl -n "$K8S_NS" rollout undo deployment/$K8S_DEPLOY || true
                    fi
                '''
            }
            echo "❌ 流水线失败，请查看日志；生产环境已尝试回滚"
            githubStatus('failure', 'pipeline failed, see Jenkins logs')
            notifyBuild('FAILURE')
        }
        always {
            cleanWs()
        }
    }
}

/**
 * 把构建结果回写到 GitHub Commit Status。
 * 前提：Jenkins 中存在 Secret text 凭据 `github-token`（repo:status 权限）。
 * Token 缺失或网络异常时只打印告警，不阻塞流水线。
 */
def githubStatus(String state, String description) {
    withEnv(["GH_STATE=${state}", "GH_DESC=${description}"]) {
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
            container('python') {
                sh '''
                    set +e
                    payload=$(printf '{"state":"%s","context":"jenkins/ci","target_url":"%s","description":"%s"}' \
                      "$GH_STATE" "$BUILD_URL" "$GH_DESC")
                    curl -fsS -X POST \
                      -H "Authorization: token $GITHUB_TOKEN" \
                      -H "Accept: application/vnd.github+json" \
                      -H "Content-Type: application/json" \
                      -d "$payload" \
                      "https://api.github.com/repos/$GITHUB_REPO/statuses/$GIT_COMMIT" >/dev/null
                    rc=$?
                    [ $rc -ne 0 ] && echo "WARN: GitHub 提交状态回写失败，请检查 github-token 凭据与权限"
                    exit 0
                '''
            }
        }
    }
}

/**
 * 可选的构建通知（钉钉机器人）。
 * 前提：Jenkins 中存在 Secret text 凭据 `dingtalk-webhook`（完整 Webhook 地址，含 access_token）。
 * 未配置时静默跳过，不影响流水线结果。
 */
def notifyBuild(String result) {
    try {
        withEnv(["NOTIFY_RESULT=${result}"]) {
            withCredentials([string(credentialsId: 'dingtalk-webhook', variable: 'DINGTALK_WEBHOOK')]) {
                container('python') {
                    sh '''
                        payload=$(printf '{"msgtype":"text","text":{"content":"Jenkins 构建 %s | %s | %s"}}' \
                          "$NOTIFY_RESULT" "$JOB_NAME" "$BUILD_URL")
                        curl -fsS -H 'Content-Type: application/json' -d "$payload" "$DINGTALK_WEBHOOK" \
                          || echo "WARN: 钉钉通知发送失败"
                    '''
                }
            }
        }
    } catch (err) {
        echo "未配置 dingtalk-webhook 凭据，跳过构建通知"
    }
}
