# 基础镜像默认取自渡渡鸟镜像同步站(https://docker.aityp.com)同步到华为云 SWR 的地址，
# 国内网络可直接拉取；需要官方镜像时用 --build-arg 覆盖，例如：
#   docker build --build-arg UI_IMAGE=node:18 --build-arg BASE_IMAGE=python:3.11 .
ARG UI_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/node:18
ARG BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/python:3.11

# 阶段1: 构建 Vue 前端
FROM ${UI_IMAGE} AS ui-builder
WORKDIR /ui
COPY ui/ /ui/
RUN npm config set registry https://registry.npmmirror.com \
    && npm install \
    && npm run build:prod

# 阶段2: Python 后端 + 前端产物
FROM ${BASE_IMAGE}
WORKDIR /app
COPY . /app
RUN pip install uv -i https://pypi.tuna.tsinghua.edu.cn/simple && uv pip install --system -r pyproject.toml --index-url https://pypi.tuna.tsinghua.edu.cn/simple
# 前端构建产物: dist/static/* -> app/static/ (Flask 默认静态目录), index.html 一并放入
COPY --from=ui-builder /ui/dist/static/. /app/app/static/
COPY --from=ui-builder /ui/dist/index.html /app/app/static/index.html
EXPOSE 5000
CMD ["python", "start.py"]
